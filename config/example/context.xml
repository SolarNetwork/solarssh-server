<Context>
	<!--
		SolarSSH does not read any X-Forwarded-* (or Forwarded) request headers itself: client
		addresses (e.g. for brute-force mitigation) come from the TCP connection only.

		If SolarSSH is ever deployed behind a reverse proxy or load balancer, configure Tomcat's
		RemoteIpValve so the container rewrites the remote address and scheme from the proxy's
		headers, trusting them only from the proxy's own addresses. Prefer placing the valve on
		the <Host> in server.xml, before the AccessLogValve, so the access log records client
		addresses too. For example:

		<Valve className="org.apache.catalina.valves.RemoteIpValve"
			internalProxies="10\.0\.\d{1,3}\.\d{1,3}"
			remoteIpHeader="X-Forwarded-For"
			protocolHeader="X-Forwarded-Proto" />
	-->
	<Environment name="ssh.keyPassword" value="changeit" type="java.lang.String" override="false"/>
	<Environment name="ssh.host" value="ssh.solarnetwork.net" type="java.lang.String" override="false"/>
	<Environment name="ssh.port" value="8022" type="java.lang.Integer" override="false"/>
	<Environment name="ssh.reversePort.min" value="43333" type="java.lang.Integer" override="false"/>
	<Environment name="ssh.reversePort.max" value="65333" type="java.lang.Integer" override="false"/>
</Context>
